
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moon-studio-forms",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",

  "vars": {
    "FIREBASE_API_KEY": "AIzaSyCoBpOgDMQSzE8TC8Xrpm5Cll8N8CJtEeA"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moon-studio-forms",
      "database_id": "4f25074b-84c4-4e63-a9bb-89fd057549a5",
      "migrations_dir": "migrations"
    }
  ]
}
